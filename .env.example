# Site URL and indexing. Set SITE_URL to the production domain at launch.
# Set INDEXABLE to true only on the production domain; previews must stay noindex.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_INDEXABLE=false

# Sanity CMS configuration.
# Copy this file to .env.local and fill in real values once a Sanity project exists.
# With these unset, the site still builds and runs (the Sanity client stays null).

# Public Sanity project id. Leave empty to run with no Sanity project configured.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Public Sanity dataset name. Defaults to "production" when unset.
NEXT_PUBLIC_SANITY_DATASET=production

# Public Sanity API version (date string). Defaults to "2025-01-01" when unset.
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only read token for authenticated/draft content. Never commit a real value.
# Required for Next.js to fetch Sanity drafts on /editor-test when draft mode is on.
# Studio editing does not need this: the logged-in Sanity session can read drafts.
SANITY_API_READ_TOKEN=

# Shared secret for /api/draft. Enables Next.js draft mode for the isolated test page.
# Never expose this as NEXT_PUBLIC_*. Leave empty to fail closed.
SANITY_PREVIEW_SECRET=
